{
	"$schema": "https://www.schemastore.org/tsconfig",
	"extends": ["@kekkon-nexus/config/ts", "@kekkon-nexus/config/ts/strict"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,

		"experimentalDecorators": true,
		"useDefineForClassFields": false,
		"strictPropertyInitialization": false,

		"noEmit": true,
		"types": ["node", "express"],
		"skipLibCheck": true
	},
	"exclude": ["./dist"]
}
